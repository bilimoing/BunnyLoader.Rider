<idea-plugin><version>0.2.5</version><idea-version since-build="261" until-build="261.*"/>
    <id>dev.bunnyloader.modtools</id>
    <name>BunnyLoaderModCreater</name>
    <vendor>末泠</vendor>
    <description><![CDATA[
        A plugin for creating BunnyLoader Mods in Rider.
    ]]></description>
    <resource-bundle>messages.BunnyBundle</resource-bundle>
    <depends>com.intellij.modules.rider</depends>
    <extensions defaultExtensionNs="com.intellij">
        <projectTemplateProviderNew implementation="dev.bunnyloader.rider.BunnyModTemplateProvider"/>
    </extensions>
    <actions>
        <action id="BunnyLoader.NewModItem" class="dev.bunnyloader.rider.NewModItemAction">
            <add-to-group group-id="NewGroup" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
